# SwasthyaSync Main Kiosk & Clinician Backend Environment Example

# AI & Speech APIs
GEMINI_API_KEY=your_gemini_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Supabase Cloud Storage & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# OTP Provider Configuration
# Set to 'fast2sms' for real India SMS or 'mock' for local development
OTP_PROVIDER=mock
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_OTP_TEMPLATE_ID=your_dlt_template_id_here
FAST2SMS_SENDER_ID=SWASTH
OTP_TEST_MODE=false
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_PHONE_WINDOW=3
OTP_SEND_WINDOW_SECONDS=900
